<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SerialBench</AssemblyName>
    <RootNamespace>SerialBench</RootNamespace>
    <ApplicationIcon>SerialPortTerminal.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Serial\**\*.cs" />
    <Compile Remove="Diagnostics\DiagnosticLog.cs" />
    <Compile Remove="SerialPortTerminal.Tests\**\*.cs" />
    <EmbeddedResource Remove="SerialPortTerminal.Tests\**\*" />
    <None Remove="SerialPortTerminal.Tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="System.IO.Ports" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="SerialCommunications\SerialCommunications.csproj" />
  </ItemGroup>

</Project>
